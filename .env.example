# Copy to .env (git-ignored) and fill in. Quarkus reads .env automatically in dev mode.

# Anthropic API key from the Claude Console. Required unless COACH_MOCK=true.
ANTHROPIC_API_KEY=

# Model used for scoring and rewrites.
COACH_MODEL=claude-sonnet-5-5

# Shared code people must enter before practicing. Leave empty to keep it open.
COACH_ACCESS_CODE=

# Max model calls per day for the whole instance.
COACH_DAILY_LIMIT=100

# true = canned responses, no API calls (UI work, demos without a key).
COACH_MOCK=false
